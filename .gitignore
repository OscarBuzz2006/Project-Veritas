# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Local run artifacts (keep compact summaries/figures/docs tracked; ignore large raw JSONL traces)
# results/ holds the recorded live runs and IS tracked; only the throwaway offline demo output
# that `make check`/`make smoke` can write there is ignored.
/results/smoke*
reports/results/*.jsonl
tmp/
.DS_Store
node_modules/
/frontend/test-results/
/frontend/playwright-report/


/frontend/.designs/
*.cpgz

# Raw numeric-final-1114 logs exceed GitHub 100 MB; compressed/stripped copies are tracked
/results/numeric-final-1114/numeric_runs.jsonl
/results/numeric-final-1114/provider_requests.jsonl

# Raw numeric-final-luna-none logs; gzipped copies are tracked
/results/numeric-final-luna-none/numeric_runs.jsonl
/results/numeric-final-luna-none/provider_requests.jsonl

# LaTeX build output (tectonic / pdflatex)
reports/tex/*.aux
reports/tex/*.bbl
reports/tex/*.blg
reports/tex/*.log
reports/tex/*.out
reports/tex/*.pdf
