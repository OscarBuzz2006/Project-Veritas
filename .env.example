# Optional live LLM provider keys (never commit a populated .env file)
# Leave all unset to run with the built-in `synthetic` or `replay` backends,
# or run local open-weight models free via Ollama (`ollama serve`).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

